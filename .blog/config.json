{
  "schemaVersion": 1,
  "theme": {
    "id": "astro-paper",
    "options": {
      "astro-paper": {},
      "astro-cactus": {}
    }
  },
  "site": {
    "url": "https://example.github.io/your-blog/",
    "title": "Your Blog",
    "description": "A blog powered by Astro.",
    "author": "Your Name",
    "ogImage": "default-og.jpg",
    "lang": "en",
    "timezone": "UTC",
    "dir": "ltr"
  },
  "home": {
    "title": "Hello World",
    "description": "Welcome to your new blog.",
    "readmeUrl": "https://github.com/example/your-blog"
  },
  "posts": {
    "perPage": 10,
    "perIndex": 10,
    "scheduledPostMargin": 900000
  },
  "features": {
    "lightAndDarkMode": true,
    "dynamicOgImage": true,
    "showArchives": true,
    "showBackButton": true,
    "editPost": {
      "enabled": false
    },
    "search": "pagefind"
  },
  "socials": [],
  "shareLinks": [
    {
      "name": "whatsapp",
      "url": "https://wa.me/?text="
    },
    {
      "name": "facebook",
      "url": "https://www.facebook.com/sharer.php?u="
    },
    {
      "name": "x",
      "url": "https://x.com/intent/post?url="
    },
    {
      "name": "telegram",
      "url": "https://t.me/share/url?url="
    },
    {
      "name": "pinterest",
      "url": "https://pinterest.com/pin/create/button/?url="
    },
    {
      "name": "mail",
      "url": "mailto:?subject=See%20this%20post&body="
    }
  ],
  "repository": {
    "owner": "example",
    "name": "your-blog",
    "defaultBranch": "main"
  },
  "writing": {
    "noteLabel": "Note",
    "blogLabel": "Blog",
    "noteContainerTitle": "Notes"
  }
}
